# ------------------------
# Server / Application
# ------------------------
PORT=                      # Port on which the backend listens
TOKEN_SECRET_KEY=          # Secret key used for JWT authentication

# ------------------------
# Database
# ------------------------
DB_HOST=                   # Database host or service name
DB_PASSWORD=               # Database password
DB_USER=                   # Database username
DB_SCHEMA=                 # Database name
DB_PORT=                   # Database port (e.g., 5432)

# ------------------------
# Gateway / Frontend
# ------------------------
GATEWAY_PORT=              # Exposed port for the Nginx gateway
VITE_BASE_URL=             # Base URL used by the frontend

# ------------------------
# Email (Gmail)
# ------------------------
GMAIL_USERNAME=            # Gmail address used by the app
GMAIL_PASSWORD=            # Gmail password or app password

# ------------------------
# Playwright / End-to-End Tests
# ------------------------
PLAYWRIGHT_BASE_URL=       # Base URL used for E2E tests

# ------------------------
# Healthchecks
# ------------------------
HEALTHCHECK_BACKEND_URL=   # URL to ping for backend health check
HEALTHCHECK_FRONTEND_URL=  # URL to ping for frontend health check